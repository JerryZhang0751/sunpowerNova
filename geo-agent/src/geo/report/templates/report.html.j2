<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SunHestia GEO / SEO 周度评测 · 第 {{ report.week }} 周</title>
  <style>
    :root {
      color-scheme: light;
      --navy: #0b1f3a;
      --navy-2: #123b65;
      --sky: #1f6feb;
      --sky-soft: #eaf2ff;
      --sun: #f5a524;
      --sun-soft: #fff7e8;
      --ink: #10233f;
      --muted: #64748b;
      --line: #e3e8ef;
      --page: #f6f8fb;
      --card: #ffffff;
      --green: #159447;
      --green-soft: #edf9f1;
      --coral: #e74b4b;
      --coral-soft: #fff1f1;
      --radius: 14px;
      --shadow: 0 12px 30px rgba(11, 31, 58, .08);
      --font: Inter, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", system-ui, -apple-system, sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--page);
      color: var(--ink);
      font-family: var(--font);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    button, select { font: inherit; }
    button, a, select, summary { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }
    code {
      border-radius: 6px;
      background: #eef2f7;
      color: #35516f;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: .78rem;
      padding: 2px 6px;
      word-break: break-all;
    }

    .layout { min-height: 100vh; }
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
      display: flex;
      width: 208px;
      flex-direction: column;
      overflow-y: auto;
      color: #fff;
      background:
        radial-gradient(circle at 20% 0, rgba(31, 111, 235, .22), transparent 28%),
        linear-gradient(180deg, #07182d 0%, var(--navy) 58%, #07182d 100%);
      box-shadow: 12px 0 30px rgba(7, 24, 45, .08);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 82px;
      padding: 20px 20px 18px;
      font-size: 1.24rem;
      font-weight: 800;
      letter-spacing: -.025em;
    }
    .sun-mark {
      position: relative;
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      border: 4px solid var(--sun);
      border-radius: 50%;
      box-shadow: 0 0 0 5px rgba(245, 165, 36, .10);
    }
    .sun-mark::before,
    .sun-mark::after {
      position: absolute;
      inset: -10px 9px;
      border-radius: 999px;
      background: var(--sun);
      content: "";
    }
    .sun-mark::after { transform: rotate(90deg); }
    .sidebar-nav { display: grid; gap: 5px; padding: 10px 10px; }
    .sidebar-nav a {
      position: relative;
      display: flex;
      min-height: 46px;
      align-items: center;
      gap: 11px;
      border-radius: 10px;
      color: #d5e0ef;
      font-size: .93rem;
      font-weight: 650;
      padding: 0 13px;
      transition: background .2s ease, color .2s ease, transform .2s ease;
    }
    .sidebar-nav a::before {
      width: 7px;
      height: 7px;
      flex: 0 0 7px;
      border: 2px solid #8ba4c1;
      border-radius: 50%;
      content: "";
      transition: border-color .2s ease, background .2s ease;
    }
    .sidebar-nav a:hover { color: #fff; background: rgba(255, 255, 255, .08); transform: translateX(2px); }
    .sidebar-nav a.active { color: #fff; background: rgba(255, 255, 255, .11); }
    .sidebar-nav a.active::after {
      position: absolute;
      inset: 7px auto 7px -10px;
      width: 4px;
      border-radius: 0 6px 6px 0;
      background: var(--sun);
      content: "";
    }
    .sidebar-nav a.active::before { border-color: var(--sun); background: var(--sun); }
    .sidebar-meta {
      margin-top: auto;
      border-top: 1px solid rgba(255, 255, 255, .10);
      color: #9fb2c9;
      font-size: .73rem;
      line-height: 1.75;
      padding: 18px 20px 22px;
    }

    .main { min-width: 0; margin-left: 208px; }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      min-height: 82px;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      border-bottom: 1px solid rgba(227, 232, 239, .84);
      background: rgba(246, 248, 251, .92);
      backdrop-filter: blur(14px) saturate(150%);
      padding: 14px clamp(20px, 3vw, 42px);
    }
    .title-block h1 { margin: 0; font-size: clamp(1.45rem, 2.1vw, 2rem); letter-spacing: -.04em; }
    .title-block p { margin: 2px 0 0; color: var(--muted); font-size: .86rem; }
    .top-actions { display: flex; align-items: center; gap: 10px; }
    .select-wrap { position: relative; }
    .select-wrap::after {
      position: absolute;
      top: calc(50% - 4px);
      right: 17px;
      width: 6px;
      height: 6px;
      border-right: 1.5px solid #64748b;
      border-bottom: 1.5px solid #64748b;
      content: "";
      pointer-events: none;
      transform: rotate(45deg);
    }
    .week-select {
      height: 42px;
      border: 1px solid #d7dee8;
      border-radius: 10px;
      background: #fff;
      color: var(--ink);
      font-weight: 650;
      padding: 0 38px 0 14px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(11, 31, 58, .04);
      transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }
    .week-select { min-width: 118px; appearance: none; }
    .week-select:hover { border-color: #9ebcea; box-shadow: 0 8px 20px rgba(31, 111, 235, .10); transform: translateY(-1px); }

    .content { max-width: 1480px; margin: 0 auto; padding: 20px clamp(18px, 3vw, 42px) 42px; }
    .focus-banner {
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid #f2cd88;
      border-radius: 12px;
      background: linear-gradient(90deg, #fff8eb, #fffdf8);
      color: #5c4215;
      font-weight: 680;
      margin-bottom: 14px;
      padding: 11px 14px;
    }
    .focus-icon {
      display: grid;
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
      place-items: center;
      border-radius: 50%;
      background: var(--sun);
      color: #fff;
      font-size: .9rem;
    }

    .section { margin-top: 14px; }
    section[id], div.section[id], details[id] { scroll-margin-top: 100px; }
    .grid { display: grid; gap: 14px; }
    .score-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .analysis-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .comparison-grid { grid-template-columns: minmax(0, 1.7fr) minmax(300px, .8fr); }
    .detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card {
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      box-shadow: 0 3px 14px rgba(11, 31, 58, .035);
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }
    .card:hover { border-color: #c9d8eb; box-shadow: var(--shadow); transform: translateY(-2px); }
    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 18px 6px;
    }
    .card-head h2,
    .card-head h3 { margin: 0; font-size: 1rem; letter-spacing: -.02em; }
    .card-subtitle { color: var(--muted); font-size: .76rem; }
    .note { color: var(--muted); font-size: .68rem; }
    .cost-row { color: var(--muted); font-size: .74rem; margin: 10px 2px 0; }
    .score-card {
      position: relative;
      display: flex;
      min-height: 154px;
      align-items: center;
      justify-content: space-between;
      overflow: hidden;
      padding: 18px 20px;
    }
    .score-card::after {
      position: absolute;
      right: -36px;
      bottom: -55px;
      width: 150px;
      height: 150px;
      border-radius: 50%;
      background: rgba(31, 111, 235, .05);
      content: "";
    }
    .score-card.geo { border-color: #c7daf8; background: linear-gradient(135deg, #fff, #f5f9ff); }
    .score-card.seo { border-color: #d2def3; background: linear-gradient(135deg, #fff, #f8faff); }
    .score-card.health { border-color: #bee2ca; background: linear-gradient(135deg, #fff, #f2fbf5); }
    .score-label { margin: 0; font-size: .95rem; font-weight: 750; }
    .score-value { margin: 4px 0 0; font-size: clamp(2.25rem, 4vw, 3.2rem); font-weight: 820; letter-spacing: -.06em; line-height: 1; }
    .score-scale { color: var(--muted); font-size: .8rem; }
    .score-tag {
      display: inline-flex;
      align-items: center;
      border: 1px solid currentColor;
      border-radius: 6px;
      font-size: .7rem;
      font-weight: 750;
      margin-top: 10px;
      padding: 2px 8px;
    }
    .score-tag.warn { color: #b86d00; background: var(--sun-soft); }
    .score-tag.good { color: var(--green); background: var(--green-soft); }
    .score-tag.bad { color: var(--coral); background: var(--coral-soft); }
    .score-ring {
      position: relative;
      z-index: 1;
      display: grid;
      width: 82px;
      height: 82px;
      flex: 0 0 82px;
      place-items: center;
      border-radius: 50%;
      background: conic-gradient(var(--ring-color, var(--sky)) calc(var(--score, 0) * 1%), #e5eaf0 0);
    }
    .score-ring::after { width: 62px; height: 62px; border-radius: 50%; background: #fff; content: ""; }
    .health-check {
      position: relative;
      z-index: 1;
      display: grid;
      width: 76px;
      height: 76px;
      place-items: center;
      border: 4px solid var(--green);
      border-radius: 50%;
      color: var(--green);
      font-size: 2.35rem;
      font-weight: 800;
    }

    .chart-card { min-height: 360px; }
    .chart { width: 100%; height: 300px; }
    .empty-state { display: grid; min-height: 220px; place-items: center; color: var(--muted); text-align: center; padding: 28px; }

    .table-wrap { overflow-x: auto; padding: 6px 16px 16px; }
    table { width: 100%; border-collapse: collapse; font-size: .78rem; }
    th { color: var(--muted); font-weight: 700; text-align: left; white-space: nowrap; }
    th, td { border-bottom: 1px solid #edf0f4; padding: 10px 8px; vertical-align: middle; }
    tbody tr { transition: background .18s ease; }
    tbody tr:hover { background: #f8faff; }
    tbody tr:last-child td { border-bottom: 0; }
    .model-name { min-width: 96px; font-weight: 750; }
    .model-meta { display: block; color: var(--muted); font-size: .65rem; font-weight: 500; margin-top: 2px; white-space: nowrap; }
    .metric-number { font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }
    .mini-bar { display: inline-block; width: 46px; height: 4px; border-radius: 999px; background: #e5eaf0; margin-left: 6px; overflow: hidden; vertical-align: middle; }
    .mini-bar > i { display: block; height: 100%; border-radius: inherit; background: var(--sky); }
    .success-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--green); margin-right: 5px; }

    .risks { display: grid; gap: 9px; padding: 8px 14px 15px; }
    .risk-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      border: 1px solid #f2d7d7;
      border-radius: 11px;
      background: linear-gradient(90deg, var(--coral-soft), #fff 38%);
      padding: 11px;
    }
    .risk-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 8px; background: var(--coral); color: #fff; font-weight: 800; }
    .risk-title { font-size: .8rem; font-weight: 760; }
    .risk-copy { color: var(--muted); font-size: .68rem; }
    .risk-score { color: var(--coral); font-size: .76rem; font-weight: 800; white-space: nowrap; }
    .risk-link { color: #c87900; font-size: .72rem; font-weight: 750; white-space: nowrap; }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin: 22px 2px 10px;
    }
    .section-heading h2 { margin: 0; font-size: 1.08rem; letter-spacing: -.025em; }
    .section-heading p { margin: 2px 0 0; color: var(--muted); font-size: .76rem; }

    .heat-list { display: grid; gap: 9px; padding: 9px 18px 16px; }
    .heat-row { display: grid; grid-template-columns: 105px minmax(80px, 1fr) 66px; align-items: center; gap: 10px; font-size: .76rem; }
    .heat-name { font-weight: 680; }
    .heat-track { height: 8px; border-radius: 999px; background: #edf1f5; overflow: hidden; }
    .heat-fill { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #5b9df5, var(--sky)); }
    .heat-fill.negative { background: linear-gradient(90deg, #f49a9a, var(--coral)); }
    .heat-value { font-variant-numeric: tabular-nums; font-weight: 800; text-align: right; }
    .heat-value.positive { color: var(--green); }
    .heat-value.negative { color: var(--coral); }
    .notice {
      display: flex;
      gap: 9px;
      border: 1px solid #f1d695;
      border-radius: 10px;
      background: var(--sun-soft);
      color: #765317;
      font-size: .72rem;
      margin: 0 18px 16px;
      padding: 10px 12px;
    }

    .rules-summary { padding: 7px 18px 16px; }
    .version-flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .version-chip { border-radius: 7px; background: var(--sky-soft); color: #245d9c; font-size: .72rem; font-weight: 750; padding: 5px 8px; }
    .version-arrow { color: var(--muted); }
    .rule-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; border-top: 1px solid #edf0f4; padding: 10px 0; }
    .rule-entry:first-of-type { border-top: 0; }
    .rule-name { font-size: .78rem; font-weight: 750; }
    .rule-meta { color: var(--muted); font-size: .67rem; margin-top: 3px; }
    .status-pill { align-self: start; border-radius: 999px; background: #eef3f8; color: #4e6278; font-size: .65rem; font-weight: 750; padding: 3px 8px; }
    .status-pill.active { background: var(--green-soft); color: var(--green); }
    .status-pill.draft { background: var(--sun-soft); color: #a96600; }
    .observation-list { margin: 10px 0 0; padding-left: 18px; color: var(--muted); font-size: .7rem; }

    .actions-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .action-card {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
      gap: 12px;
      min-height: 118px;
      padding: 16px;
    }
    .action-index { display: grid; width: 27px; height: 27px; place-items: center; border-radius: 7px; background: var(--sky); color: #fff; font-size: .78rem; font-weight: 800; box-shadow: 0 5px 12px rgba(31, 111, 235, .2); }
    .action-title { margin: 0; font-size: .86rem; font-weight: 780; }
    .action-copy { color: var(--muted); font-size: .7rem; margin: 4px 0 0; }
    .action-arrow { color: #9aabc0; font-size: 1.2rem; transition: color .2s ease, transform .2s ease; }
    .action-card:hover .action-arrow { color: var(--sky); transform: translateX(3px); }

    details.appendix { overflow: hidden; margin-top: 14px; }
    details.appendix > summary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      color: #274666;
      font-size: .83rem;
      font-weight: 760;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }
    details.appendix > summary::-webkit-details-marker { display: none; }
    details.appendix > summary::after { color: var(--sky); content: "⌄"; font-size: 1.1rem; transition: transform .2s ease; }
    details.appendix[open] > summary::after { transform: rotate(180deg); }
    details.appendix[open] > summary { border-bottom: 1px solid var(--line); }
    .appendix-body { display: grid; gap: 14px; padding: 14px; }
    .appendix-table th:nth-child(n+2),
    .appendix-table td:nth-child(n+2):not(:last-child) { text-align: right; }
    .dim-name { min-width: 118px; font-weight: 750; }
    .dim-code { display: block; color: #94a3b8; font-family: ui-monospace, monospace; font-size: .62rem; font-weight: 500; }
    .signals { display: flex; min-width: 230px; flex-wrap: wrap; gap: 5px; }
    .signal-chip { border-radius: 6px; background: #f1f5f9; color: #52667d; font-size: .64rem; padding: 3px 6px; }
    .signal-chip strong { color: var(--ink); }
    .footer { color: #8b9aab; font-size: .68rem; text-align: center; padding: 25px 12px 2px; }

    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

    @media (max-width: 1120px) {
      .topbar { align-items: flex-start; }
      .top-actions { flex-wrap: wrap; justify-content: flex-end; }
      .comparison-grid, .detail-grid { grid-template-columns: 1fr; }
      .actions-grid { grid-template-columns: 1fr; }
      .action-card { min-height: auto; }
    }
    @media (max-width: 900px) {
      .sidebar { position: static; width: 100%; max-height: none; }
      .brand { min-height: 64px; padding: 14px 18px; }
      .sidebar-nav { display: flex; overflow-x: auto; padding: 5px 12px 11px; scrollbar-width: none; }
      .sidebar-nav::-webkit-scrollbar { display: none; }
      .sidebar-nav a { min-width: max-content; min-height: 39px; }
      .sidebar-nav a.active::after { inset: auto 12px -6px; width: auto; height: 3px; border-radius: 5px 5px 0 0; }
      .sidebar-meta { display: none; }
      .main { margin-left: 0; }
      .topbar { position: static; }
      .score-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .score-card.health { grid-column: 1 / -1; }
    }
    @media (max-width: 680px) {
      .topbar { display: block; padding: 15px 16px; }
      .top-actions { justify-content: flex-start; margin-top: 12px; }
      .content { padding: 14px 12px 30px; }
      .score-grid, .analysis-grid { grid-template-columns: 1fr; }
      .score-card.health { grid-column: auto; }
      .chart-card { min-height: 330px; }
      .chart { height: 270px; }
      .focus-banner { align-items: flex-start; font-size: .83rem; }
      .section-heading { align-items: flex-start; flex-direction: column; }
      .heat-row { grid-template-columns: 94px minmax(60px, 1fr) 54px; }
      .risk-link { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
    @media print {
      @page { margin: 12mm; }
      body { background: #fff; }
      .sidebar, .top-actions { display: none !important; }
      .main { margin-left: 0; }
      .topbar { position: static; min-height: auto; background: #fff; padding: 0 0 14px; }
      .content { max-width: none; padding: 0; }
      .card { break-inside: avoid; box-shadow: none; }
      .card:hover { transform: none; }
      details.appendix:not([open]) > *:not(summary) { display: block; }
      details.appendix > summary { display: none; }
    }
  </style>
</head>
<body>
{% set geo = report.self_geo if report.self_geo else none %}
{% set seo = report.self_seo if report.self_seo else none %}
{% set dim_names = {
  'citability': '可引用性', 'brand': '品牌表现', 'eeat': '权威可信度',
  'technical_geo': '技术基础', 'schema': '结构化数据', 'platform': '平台覆盖',
  'crawlability_index': '抓取可达性', 'technical_foundation': '技术基础',
  'on_page': '页面优化', 'content_eeat': '内容可信度', 'authority': '外部权威'
} %}
{% set signal_names = {
  'datapoint_count': '数据点数量', 'faq_block_count': 'FAQ 模块数量',
  'has_definition_segment': '包含定义段落', 'list_count': '列表数量', 'table_count': '数据表数量',
  'cited_count': '被引用次数', 'entity_known': '实体已识别', 'mention_count': '品牌提及次数', 'sov_share': '品牌声量份额',
  'cites_external_sources': '引用外部来源', 'has_author_byline': '包含作者署名', 'has_publish_date': '包含发布日期',
  'org_or_person_schema': '组织或人物结构化数据', 'canonical_present': '规范链接存在', 'https': 'HTTPS 可用',
  'robots_claudebot': '允许 ClaudeBot', 'robots_gptbot': '允许 GPTBot',
  'has_article': '文章结构化数据', 'has_faqpage': 'FAQ 结构化数据', 'has_breadcrumblist': '面包屑结构化数据', 'has_organization': '组织结构化数据',
  'has_product': '产品结构化数据', 'schema_type_count': '结构化数据类型数量',
  'on_linkedin': 'LinkedIn 覆盖', 'on_reddit': 'Reddit 覆盖', 'on_wikipedia': 'Wikipedia 覆盖', 'on_youtube': 'YouTube 覆盖',
  'canonical_self': '规范链接指向自身', 'http_200': '页面正常响应', 'in_sitemap': '已进入站点地图',
  'robots_not_blocked': '未被爬虫规则阻止', 'http2': '支持 HTTP/2', 'mobile_viewport': '移动端视口适配',
  'renderable_static': '静态内容可渲染', 'heading_hierarchy_ok': '标题层级正确', 'meta_desc_present': '包含页面摘要',
  'single_h1': '单一一级标题', 'title_len_ok': '标题长度合适', 'unique_title': '标题唯一',
  'word_count_band': '正文篇幅', 'backlinks_est': '外部链接估算', 'gsc_clicks': '搜索点击',
  'gsc_ctr': '搜索点击率', 'gsc_impressions': '搜索曝光'
} %}
{% set model_names = {'doubao': '豆包', 'qwen': '通义千问', 'zhipu': '智谱清言'} %}
{% set action_copy = {
  'citability': {'title': '增加 FAQ 与数据表', 'copy': '为重点页面补充问答、列表与结构化数据表，提高内容被直接引用的概率。'},
  'brand': {'title': '强化品牌被引用内容', 'copy': '围绕核心主题补充可验证的品牌事实和差异化证据。'},
  'eeat': {'title': '补充作者与发布日期', 'copy': '为所有核心页面补齐作者、发布日期和可靠外部来源。'},
  'technical_geo': {'title': '修复 GEO 技术基础', 'copy': '检查协议、规范链接和 AI 爬虫访问规则。'},
  'schema': {'title': '扩充结构化数据类型', 'copy': '按页面类型补充文章、产品、FAQ 和面包屑结构化数据。'},
  'platform': {'title': '建立外部平台内容矩阵', 'copy': '布局主流社区与内容平台，提升品牌实体覆盖和可见度。'},
  'crawlability_index': {'title': '检查抓取可达性', 'copy': '修复页面响应、站点地图和爬虫规则中的阻断项。'},
  'technical_foundation': {'title': '修复 SEO 技术基础', 'copy': '完善 HTTPS、HTTP/2、移动适配与静态渲染。'},
  'on_page': {'title': '优化页面标题与层级', 'copy': '调整标题长度、页面摘要和内容标题结构。'},
  'content_eeat': {'title': '补全可信内容信息', 'copy': '增加作者、日期、来源和足够的正文信息。'},
  'authority': {'title': '建设外部权威信号', 'copy': '通过高质量引用、搜索表现和行业链接积累可信度。'}
} %}
{% set action_pool = namespace(items=[]) %}
{% if geo and geo.dims %}{% for d in geo.dims %}{% set action_pool.items = action_pool.items + [{'name': d.name, 'score': d.score}] %}{% endfor %}{% endif %}
{% if seo and seo.dims %}{% for d in seo.dims %}{% set action_pool.items = action_pool.items + [{'name': d.name, 'score': d.score}] %}{% endfor %}{% endif %}
{% set ranked_actions = action_pool.items | sort(attribute='score') %}
{% set counts = namespace(planned=0, valid=0, failed=0) %}
{% for _, metric in report.metrics.items() | sort %}
  {% if metric.planned is defined and metric.planned is not none %}{% set counts.planned = counts.planned + metric.planned %}{% endif %}
  {% if metric.valid is defined and metric.valid is not none %}{% set counts.valid = counts.valid + metric.valid %}{% endif %}
  {% if metric.failed is defined and metric.failed is not none %}{% set counts.failed = counts.failed + metric.failed %}{% endif %}
{% endfor %}

<div class="layout">
  <aside class="sidebar" aria-label="报告导航">
    <a class="brand" href="#overview" aria-label="SunHestia 报告首页"><span class="sun-mark" aria-hidden="true"></span><span>SunHestia</span></a>
    <nav class="sidebar-nav">
      <a class="active" href="#overview">本周概览</a><a href="#geo-seo-analysis">GEO / SEO 分析</a>
      <a href="#model-comparison">模型对比</a><a href="#diagnostics">竞品差距 / 规则迭代</a><a href="#data-appendix">数据附录</a>
    </nav>
    <div class="sidebar-meta">评分规则 {{ report.rule_version }}<br>提示词集 {{ report.prompt_set_version }}</div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="title-block"><h1>GEO / SEO 周度评测</h1><p>第 {{ report.week }} 周 · SunHestia</p></div>
      <div class="top-actions">
        <label class="select-wrap"><span class="sr-only">切换报告周次</span><select class="week-select" id="week-select" aria-label="切换报告周次">{% for week in range(1, report.week + 1) %}<option value="{{ week }}"{% if week == report.week %} selected{% endif %}>第 {{ week }} 周</option>{% endfor %}</select></label>
      </div>
    </header>

    <div class="content">
      <section class="section" id="overview" aria-labelledby="overview-title">
        <h2 class="sr-only" id="overview-title">执行摘要</h2>
        <div class="focus-banner"><span class="focus-icon" aria-hidden="true">★</span><span>本周重点：{% if ranked_actions %}优先推进“{{ action_copy.get(ranked_actions[0].name, {'title': dim_names.get(ranked_actions[0].name, ranked_actions[0].name)}).title }}”{% if ranked_actions | length > 1 %}与“{{ action_copy.get(ranked_actions[1].name, {'title': dim_names.get(ranked_actions[1].name, ranked_actions[1].name)}).title }}”{% endif %}{% else %}等待完整评分数据后生成重点建议{% endif %}</span></div>
        <div class="grid score-grid">
          <article class="card score-card geo"><div><p class="score-label">GEO 综合得分</p><div class="score-value">{{ '%.1f'|format(geo.total) if geo and geo.total is not none else '—' }}</div><div class="score-scale">满分 100</div>{% if geo and geo.total is not none and geo.total >= 70 %}<span class="score-tag good">表现良好</span>{% elif geo and geo.total is not none and geo.total >= 40 %}<span class="score-tag warn">需提升</span>{% else %}<span class="score-tag bad">优先改进</span>{% endif %}</div><div class="score-ring" style="--score: {{ geo.total if geo and geo.total is not none else 0 }}; --ring-color: var(--sky)" aria-hidden="true"></div></article>
          <article class="card score-card seo"><div><p class="score-label">SEO 综合得分</p><div class="score-value">{{ '%.1f'|format(seo.total) if seo and seo.total is not none else '—' }}</div><div class="score-scale">满分 100</div>{% if seo and seo.total is not none and seo.total >= 70 %}<span class="score-tag good">表现良好</span>{% elif seo and seo.total is not none and seo.total >= 40 %}<span class="score-tag warn">需提升</span>{% else %}<span class="score-tag bad">优先改进</span>{% endif %}</div><div class="score-ring" style="--score: {{ seo.total if seo and seo.total is not none else 0 }}; --ring-color: #367be5" aria-hidden="true"></div></article>
          <article class="card score-card health"><div><p class="score-label">采集完成率</p>{% if counts.planned %}<div class="score-value">{{ '{:.0%}'.format(counts.valid / counts.planned) }}</div><div class="score-scale">{{ counts.valid }} / {{ counts.planned }} 条有效{% if counts.failed %} · {{ counts.failed }} 条失败{% endif %}</div>{% else %}<div class="score-value">—</div><div class="score-scale">旧报告未记录采集分母</div>{% endif %}{% if report.collection_gate is defined and report.collection_gate and report.collection_gate.manifest and report.collection_gate.ok %}<span class="score-tag good">已通过质量门 · 最低 {{ '{:.1%}'.format(report.collection_gate.min_success_rate or 0) }}</span>{% elif report.collection_gate is defined and report.collection_gate and report.collection_gate.manifest %}<span class="score-tag bad">未通过质量门 · 最低 {{ '{:.1%}'.format(report.collection_gate.min_success_rate or 0) }}</span>{% else %}<span class="score-tag warn">完整性待确认</span>{% endif %}</div>{% if report.collection_gate is defined and report.collection_gate and report.collection_gate.manifest and report.collection_gate.ok %}<div class="health-check" aria-hidden="true">✓</div>{% else %}<div class="health-check" style="border-color: var(--sun); color: var(--sun)" aria-hidden="true">!</div>{% endif %}</article>
        </div>
        {% if report.cost and report.cost.by_model %}<div class="cost-row">成本(token,不折价):{% for m, c in report.cost.by_model.items() | sort %}{{ m }} {{ c.total_tokens }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      </section>

      <div class="grid analysis-grid section" id="geo-seo-analysis">
        <section class="card chart-card" id="geo-analysis" aria-labelledby="geo-title"><div class="card-head"><h2 id="geo-title">GEO 六维表现</h2><span class="card-subtitle">得分 / 权重</span></div>{% if geo and geo.dims %}<div class="chart" id="geo-chart" role="img" aria-label="GEO 六维得分与权重雷达图"></div>{% else %}<div class="empty-state">本期无 GEO 维度数据</div>{% endif %}</section>
        <section class="card chart-card" id="seo-analysis" aria-labelledby="seo-title"><div class="card-head"><h2 id="seo-title">SEO 五项表现</h2><span class="card-subtitle">得分 / 权重</span><span class="note">w4+ 维度=全页平均(w1–w3 为代表页口径,跨周维度对比有断点)</span></div>{% if seo and seo.dims %}<div class="chart" id="seo-chart" role="img" aria-label="SEO 五项得分与权重条形图"></div>{% else %}<div class="empty-state">本期无 SEO 维度数据</div>{% endif %}</section>
      </div>

      <div class="grid comparison-grid section">
        <section class="card" id="model-comparison" aria-labelledby="models-title"><div class="card-head"><h2 id="models-title">模型横向对比</h2><span class="card-subtitle">数据均按本周有效回答计算</span></div><div class="table-wrap"><table><thead><tr><th>模型</th><th>成功率</th><th>品牌提及率</th><th>引用率</th><th>平均位置</th><th>声量占比</th></tr></thead><tbody>{% for model, metric in report.metrics.items() | sort %}<tr><td class="model-name">{{ model_names.get(model, model) }}<span class="model-meta">计划 {{ metric.planned if metric.planned is defined else '—' }} · 有效 {{ metric.valid if metric.valid is defined else '—' }} · 失败 {{ metric.failed if metric.failed is defined else '—' }}</span></td><td class="metric-number">{% if metric.success_rate is defined and metric.success_rate is not none %}<span class="success-dot"></span>{{ '{:.1%}'.format(metric.success_rate) }}{% else %}—{% endif %}</td><td class="metric-number">{{ '{:.1%}'.format(metric.mention_rate) }}<span class="mini-bar"><i style="width: {{ metric.mention_rate * 100 }}%"></i></span></td><td class="metric-number">{{ '{:.1%}'.format(metric.citation_rate) }}<span class="mini-bar"><i style="width: {{ metric.citation_rate * 100 }}%"></i></span></td><td class="metric-number">{{ '%.1f'|format(metric.avg_position) if metric.avg_position is not none else '—' }}</td><td class="metric-number">{{ '{:.1%}'.format(metric.sov) }}<span class="mini-bar"><i style="width: {{ metric.sov * 100 }}%"></i></span></td></tr>{% else %}<tr><td colspan="6">本期无模型对比数据</td></tr>{% endfor %}</tbody></table></div></section>
        <section class="card" aria-labelledby="risks-title"><div class="card-head"><h2 id="risks-title">关键风险</h2><span class="card-subtitle">按低分项识别</span></div><div class="risks">{% for risk in ranked_actions[:2] %}{% set copy = action_copy.get(risk.name, {'title': dim_names.get(risk.name, risk.name), 'copy': '该维度得分偏低，建议优先检查相关信号。'}) %}<div class="risk-item"><span class="risk-icon" aria-hidden="true">!</span><div><div class="risk-title">{{ copy.title }}</div><div class="risk-copy">{{ dim_names.get(risk.name, risk.name) }}当前得分偏低</div></div><div><div class="risk-score">{{ '%.1f'|format(risk.score) }} 分</div><a class="risk-link" href="#recommendations">查看建议 →</a></div></div>{% else %}<div class="empty-state" style="min-height: 150px">本期暂无可识别的风险项</div>{% endfor %}</div></section>
      </div>

      <div class="section-heading"><div><h2>诊断与迭代</h2><p>查看竞品差距、证据边界和规则变化</p></div></div>
      <div class="grid detail-grid section" id="diagnostics">
        <section class="card" id="competitor-gap" aria-labelledby="gap-title"><div class="card-head"><h2 id="gap-title">竞品差距</h2><span class="card-subtitle">正值表示领先，负值表示落后</span></div>{% if report.gap %}<div class="heat-list">{% for name, diff in report.gap.dim_diff.items() | sort %}{% set magnitude = diff if diff >= 0 else -diff %}<div class="heat-row"><span class="heat-name">{{ dim_names.get(name, name) }}</span><span class="heat-track"><i class="heat-fill{% if diff < 0 %} negative{% endif %}" style="width: {{ 100 if magnitude > 100 else magnitude }}%"></i></span><span class="heat-value {{ 'positive' if diff >= 0 else 'negative' }}">{{ '+' if diff > 0 else '' }}{{ '%.1f'|format(diff) }}</span></div>{% endfor %}</div>{% else %}<div class="empty-state">本期无竞品 L3 数据，竞品差距暂缺；GEO 自审仍独立产出。</div>{% endif %}<div class="notice"><span aria-hidden="true">⚠</span><span>{{ report.authority_gap_note }}。竞品评分为下界代理，静态信号按 0 计，差值不可直接理解为完整竞争优势。</span></div></section>
        <section class="card" id="rules-iteration" aria-labelledby="rules-title"><div class="card-head"><h2 id="rules-title">规则迭代摘要</h2><span class="card-subtitle">本周评分仍使用 {{ report.rule_version }}</span></div><div class="rules-summary">{% if report.rules_iteration %}{% set iteration = report.rules_iteration %}<div class="version-flow"><span class="version-chip">{{ iteration.from_version }}</span><span class="version-arrow">→</span><span class="version-chip">{{ iteration.to_version or iteration.from_version }}</span><span class="card-subtitle">变更自下周生效</span></div>{% for entry in iteration.entries %}<div class="rule-entry"><div><div class="rule-name">{{ signal_names.get(entry.signal, entry.signal) }}</div><div class="rule-meta">目标：{{ dim_names.get(entry.target, entry.target) }} · 证据覆盖 {{ '{:.1%}'.format(entry.evidence.share or 0) }} · {{ entry.evidence.unique_n }} 个唯一页面 · {{ entry.evidence.platforms | length }} 个平台</div></div><span class="status-pill {{ entry.status }}">{{ {'active':'已生效','draft':'草案','rejected':'已拒绝'}.get(entry.status, entry.status) }}</span></div>{% endfor %}{% if iteration.weights_after == iteration.weights_before %}<p class="card-subtitle">本期权重未调整，继续等待持续性证据。</p>{% endif %}{% if iteration.observations %}<ul class="observation-list">{% for observation in iteration.observations %}<li>{{ observation }}</li>{% endfor %}</ul>{% endif %}{% else %}<div class="empty-state">本期无规则迭代记录。</div>{% endif %}</div></section>
      </div>

      <section class="section" id="recommendations" aria-labelledby="recommendations-title"><div class="section-heading"><div><h2 id="recommendations-title">本周优化建议</h2><p>根据当前最低分维度自动排序，优先处理前三项</p></div></div><div class="grid actions-grid">{% for action in ranked_actions[:3] %}{% set copy = action_copy.get(action.name, {'title': '提升' ~ dim_names.get(action.name, action.name), 'copy': '检查该维度的低分信号并制定改进措施。'}) %}<a class="card action-card" href="#data-appendix"><span class="action-index">{{ loop.index }}</span><div><p class="action-title">{{ copy.title }}</p><p class="action-copy">{{ copy['copy'] }} 当前得分 {{ '%.1f'|format(action.score) }}。</p></div><span class="action-arrow" aria-hidden="true">›</span></a>{% else %}<div class="card empty-state" style="grid-column: 1 / -1">本期评分数据不足，暂不生成优化建议。</div>{% endfor %}</div></section>

      {% macro score_detail(title, obj) -%}
      <section><div class="card-head"><h3>{{ title }}详细数据</h3>{% if obj %}<span class="card-subtitle">总分 {{ '%.1f'|format(obj.total) }}/100</span>{% endif %}</div>{% if obj and obj.dims %}<div class="table-wrap"><table class="appendix-table"><thead><tr><th>维度</th><th>得分</th><th>权重</th><th>加权得分</th><th>构成信号</th></tr></thead><tbody>{% for dimension in obj.dims %}<tr><td class="dim-name">{{ dim_names.get(dimension.name, dimension.name) }}<span class="dim-code">{{ dimension.name }}</span></td><td class="metric-number">{{ '%.1f'|format(dimension.score) }}</td><td class="metric-number">{{ '%.0f'|format(dimension.weight) }}%</td><td class="metric-number">{{ '%.2f'|format(dimension.score * dimension.weight / 100) }}</td><td><div class="signals">{% if dimension.signals %}{% for name, value in dimension.signals.items() | sort %}<span class="signal-chip" title="{{ name }}">{{ signal_names.get(name, name) }} <strong>{{ value | fmt_signal }}</strong></span>{% endfor %}{% else %}—{% endif %}</div></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state" style="min-height: 120px">本期无维度明细</div>{% endif %}</section>
      {%- endmacro %}
      <details class="card appendix section" id="data-appendix"><summary><span class="appendix-label" data-count="{{ (geo.dims | length if geo and geo.dims else 0) + (seo.dims | length if seo and seo.dims else 0) }}">展开数据附录（{{ (geo.dims | length if geo and geo.dims else 0) + (seo.dims | length if seo and seo.dims else 0) }} 项）</span></summary><div class="appendix-body">{{ score_detail('GEO', geo) }}{{ score_detail('SEO', seo) }}</div></details>
      <footer class="footer">SunHestia GEO / SEO 周度评测 · 评分规则 {{ report.rule_version }} · 提示词集 {{ report.prompt_set_version }}</footer>
    </div>
  </main>
</div>

<script>{{ echarts_js }}</script>
<script>
  const reportData = {{ report | tojson }};
  const dimensionNames = {{ dim_names | tojson }};
  const geoData = reportData.self_geo;
  const seoData = reportData.self_seo;
  let geoChart = null;
  let seoChart = null;
  const metricText = item => `${Number(item.score).toFixed(1)} 分 / ${Number(item.weight).toFixed(1).replace(/\.0$/, '')}%`;

  function radarOption() {
    return {
      animationDuration: 650,
      color: ['#1f6feb'],
      tooltip: { trigger: 'item', backgroundColor: '#0b1f3a', borderWidth: 0, textStyle: { color: '#fff' }, formatter: () => geoData.dims.map(item => `${dimensionNames[item.name] || item.name}：${metricText(item)}`).join('<br>') },
      radar: { center: ['50%', '53%'], radius: '54%', indicator: geoData.dims.map(item => ({ name: `${dimensionNames[item.name] || item.name}\n${metricText(item)}`, max: 100 })), axisName: { formatter: value => { const parts = value.split('\n'); return `{name|${parts[0]}}\n{metric|${parts[1]}}`; }, rich: { name: { color: '#41506b', fontSize: 12, lineHeight: 18 }, metric: { color: '#1f6feb', fontSize: 10, fontWeight: 700, lineHeight: 16 } } }, splitNumber: 4, splitArea: { areaStyle: { color: ['#ffffff', '#f8faff'] } }, splitLine: { lineStyle: { color: '#dbe4ef' } }, axisLine: { lineStyle: { color: '#dbe4ef' } } },
      series: [{ type: 'radar', symbol: 'circle', symbolSize: 6, lineStyle: { width: 2.5 }, areaStyle: { color: 'rgba(31,111,235,.18)' }, data: [{ value: geoData.dims.map(item => item.score) }] }]
    };
  }

  function barOption() {
    return {
      animationDuration: 650,
      grid: { left: 112, right: 118, top: 16, bottom: 32 },
      tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, backgroundColor: '#0b1f3a', borderWidth: 0, textStyle: { color: '#fff' }, formatter: params => `${params[0].name}：${metricText(seoData.dims[params[0].dataIndex])}` },
      xAxis: { type: 'value', max: 100, axisLine: { show: false }, axisTick: { show: false }, splitLine: { lineStyle: { color: '#edf1f5' } }, axisLabel: { color: '#7a899b', fontSize: 10 } },
      yAxis: { type: 'category', inverse: true, data: seoData.dims.map(item => dimensionNames[item.name] || item.name), axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: '#41506b', fontSize: 12 } },
      series: [{ type: 'bar', data: seoData.dims.map(item => item.score), barWidth: 9, showBackground: true, backgroundStyle: { color: '#edf1f5', borderRadius: 8 }, itemStyle: { borderRadius: 8, color: params => ['#1f6feb', '#367be5', '#f5a524', '#159447', '#e74b4b'][params.dataIndex % 5] }, label: { show: true, position: 'right', color: '#10233f', fontWeight: 700, formatter: params => metricText(seoData.dims[params.dataIndex]) } }]
    };
  }

  if (geoData && geoData.dims && geoData.dims.length) { geoChart = echarts.init(document.getElementById('geo-chart')); geoChart.setOption(radarOption()); }
  if (seoData && seoData.dims && seoData.dims.length) { seoChart = echarts.init(document.getElementById('seo-chart')); seoChart.setOption(barOption()); }

  document.getElementById('week-select').addEventListener('change', event => { const week = Number(event.target.value); if (week && week !== Number(reportData.week)) window.location.href = `../w${week}/report.html`; });

  const appendix = document.getElementById('data-appendix');
  const appendixLabel = appendix.querySelector('.appendix-label');
  const syncAppendixLabel = () => { appendixLabel.textContent = `${appendix.open ? '收起' : '展开'}数据附录（${appendixLabel.dataset.count} 项）`; };
  appendix.addEventListener('toggle', syncAppendixLabel);
  document.querySelectorAll('.action-card').forEach(card => card.addEventListener('click', () => { appendix.open = true; syncAppendixLabel(); }));

  const navigationLinks = [...document.querySelectorAll('.sidebar-nav a')];
  const observedSections = navigationLinks.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      navigationLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === `#${visible.target.id}`));
    }, { rootMargin: '-15% 0px -70% 0px', threshold: [0, .25, .6] });
    observedSections.forEach(section => observer.observe(section));
  }
  const resizeCharts = () => { if (geoChart) geoChart.resize(); if (seoChart) seoChart.resize(); };
  window.addEventListener('resize', resizeCharts);
</script>
</body>
</html>
