<!doctype html><html lang="zh"><head><meta charset="utf-8">
<title>SunHestia GEO/SEO 报告 W{{ report.week }}</title>
<style>body{font-family:system-ui,sans-serif;max-width:1100px;margin:2rem auto;padding:0 1rem}
.gap{background:#fff3cd;padding:.6rem;border-radius:.4rem;margin:1rem 0}
.note{font-size:0.85em;color:#6c757d;margin:0.5rem 0}
section{margin:2rem 0;border:1px solid #dee2e6;border-radius:.4rem;padding:1.5rem}
table{border-collapse:collapse;width:100%;margin:1rem 0}
table td,table th{border:1px solid #dee2e6;padding:.5rem;text-align:left}
h1,h2,h3{color:#212529}</style>
</head><body>
<h1>SunHestia 评测报告 · 第 {{ report.week }} 周</h1>
<p>rule_version: <code>{{ report.rule_version }}</code> · prompt_set_version: <code>{{ report.prompt_set_version }}</code></p>

<section>
<h2>①执行摘要</h2>
<p>GEO总分: <strong>{{ '%.1f'|format(report.self_geo.total) if report.self_geo else '-' }}</strong>/100</p>
<p>SEO总分: <strong>{{ '%.1f'|format(report.self_seo.total) if report.self_seo else '-' }}</strong>/100</p>
{% if report.collection_gate is defined and report.collection_gate %}
{% set cg = report.collection_gate %}
<p>采集门(成功率 ≥ {{ '{:.0%}'.format(cg.threshold) }}):
{% if not cg.manifest %}<span class="note">legacy(无 runs.jsonl,分母不可追溯)</span>
{% elif cg.ok %}<strong style="color:#198754">通过</strong>(最低 {{ '{:.1%}'.format(cg.min_success_rate) }})
{% else %}<strong style="color:#dc3545">未达</strong>(最低 {{ '{:.1%}'.format(cg.min_success_rate or 0) }})</p>
<p class="note">采集成功率低于门槛,本周数据不完整;failed 项见下表,重跑采集补齐后再评估。</p>
{% endif %}</p>
{% endif %}
</section>

<section>
<h2>②自审 GEO 6维雷达</h2>
<div id="geo" style="width:520px;height:360px"></div>
<p>GEO 6维得分详情</p>
</section>

<section>
<h2>②自审 SEO 5支柱</h2>
<div id="seo" style="width:520px;height:360px"></div>
<p>SEO 5支柱得分详情</p>
</section>

<section>
<h2>3 模型横向对比</h2><table border=1>
<tr><th>model</th><th>planned</th><th>valid</th><th>failed</th><th>success</th><th>mention</th><th>citation</th><th>position</th><th>SOV</th></tr>
{% for m,v in report.metrics.items()|sort %}<tr><td>{{ m }}</td>
<td>{{ v.planned if v.planned is defined else '-' }}</td>
<td>{{ v.valid if v.valid is defined else '-' }}</td>
<td>{{ v.failed if v.failed is defined else '-' }}</td>
<td>{{ '{:.1%}'.format(v.success_rate) if v.success_rate is defined and v.success_rate is not none else '-' }}</td>
<td>{{ '%.3f'|format(v.mention_rate) }}</td>
<td>{{ '%.3f'|format(v.citation_rate) }}</td><td>{{ v.avg_position if v.avg_position is not none else '-' }}</td>
<td>{{ '%.3f'|format(v.sov) }}</td></tr>{% endfor %}</table>
</section>

<section>
<h2>④竞品差值热图</h2>
<h3>各维度与竞品的差异</h3>
{% if report.gap %}
<table border=1>
<tr><th>维度</th><th>差值</th></tr>
{% for dim, diff in report.gap.dim_diff.items()|sort %}<tr><td>{{ dim }}</td><td>{{ '%.1f'|format(diff) }}</td></tr>{% endfor %}
</table>
{% else %}
<p>本期无竞品 L3 数据，竞品差值暂缺（GEO 自审仍独立产出）。</p>
{% endif %}
<div class="gap">⚠️ {{ report.authority_gap_note }}</div>
<p class="note">竞品评分为下界代理(静态信号按 0 计),gap 不可直读。</p>
</section>

<section>
<h2>⑤规则迭代摘要</h2>
<p>当前规则版本: <code>{{ report.rule_version }}</code></p>
{% if report.rules_iteration %}
{% set ri = report.rules_iteration %}
<p>本期迭代: <code>{{ ri.from_version }}</code> → <code>{{ ri.to_version or ri.from_version }}</code>
(本周评分用 {{ ri.from_version }},变更自下周生效)</p>
<table border=1>
<tr><th>signal</th><th>type</th><th>target</th><th>status</th><th>change</th><th>share</th><th>unique_n</th><th>platforms</th><th>weeks</th></tr>
{% for e in ri.entries %}
<tr><td>{{ e.signal }}</td><td>{{ e.type }}</td><td>{{ e.target }}</td><td>{{ e.status }}</td>
<td>{{ e.change }}</td><td>{{ "{:.1%}".format(e.evidence.share or 0) }}</td>
<td>{{ e.evidence.unique_n }}</td><td>{{ e.evidence.platforms | length }}</td>
<td>{{ e.evidence.weeks | join(',') }}</td></tr>
{% endfor %}
</table>
<p>权重调整:
{% for k in ri.weights_before %}{% if ri.weights_after.get(k) != ri.weights_before[k] %}{{ k }} {{ ri.weights_before[k] }}→{{ ri.weights_after[k] }}; {% endif %}{% endfor %}
{% if ri.weights_after == ri.weights_before %}(无){% endif %}</p>
<ul>{% for o in ri.observations %}<li>{{ o }}</li>{% endfor %}</ul>
{% else %}
<p>本期无规则迭代记录。</p>
{% endif %}
</section>

<section>
<h2>⑥优化建议</h2>
<p>基于GEO和SEO分析结果的关键优化建议</p>
<ul>
<li>提升低分维度表现</li>
<li>强化关键词覆盖与竞争定位</li>
</ul>
</section>

{% macro score_detail(obj) -%}
{% if obj %}<p>总分 <strong>{{ '%.1f'|format(obj.total) }}</strong>/100</p>
{% if obj.dims %}<table border=1><tr><th>维度</th><th>得分</th><th>权重</th><th>加权</th><th>信号</th></tr>
{% for d in obj.dims %}<tr><td>{{ d.name }}</td><td>{{ '%.1f'|format(d.score) }}</td><td>{{ '%.0f'|format(d.weight) }}%</td><td>{{ '%.2f'|format(d.score * d.weight / 100) }}</td><td>{% if d.signals %}<ul>{% for k, v in d.signals.items()|sort %}<li><code>{{ k }}</code>= {{ v|fmt_signal }}</li>{% endfor %}</ul>{% else %}—{% endif %}</td></tr>
{% endfor %}</table>
{% else %}<p>（无维度明细）</p>{% endif %}
{% else %}<p>（本期无数据）</p>{% endif %}
{%- endmacro %}
<section>
<h2>⑦数据附录</h2>
<h3>GEO详细数据</h3>
{{ score_detail(report.self_geo) }}
<h3>SEO详细数据</h3>
{{ score_detail(report.self_seo) }}
</section>

<footer>SunHestia GEO/SEO platform · P0</footer>
<script>{{ echarts_js }}</script>
<script>
const G={{ report.self_geo | tojson }};
new echarts.init(document.getElementById('geo')).setOption({
  radar:{indicator:G.dims.map(d=>({name:d.name,max:100}))},
  series:[{type:'radar',data:[{value:G.dims.map(d=>d.score)}]}]});

const S={{ report.self_seo | tojson }};
new echarts.init(document.getElementById('seo')).setOption({
  radar:{indicator:S.dims.map(d=>({name:d.name,max:100}))},
  series:[{type:'radar',data:[{value:S.dims.map(d=>d.score)}]}]});
</script>
</body></html>