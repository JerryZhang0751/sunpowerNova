---
const year = "2026";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div style="max-width: 280px">
        <div class="brand" style="color:#fff; margin-bottom: 12px">
          <span class="dot" aria-hidden="true"></span>
          <span>SunHestia</span>
        </div>
        <p style="color:#8aa0bd; margin:0; font-size:0.95rem">
          Residential solar photovoltaic and battery storage for European
          homeowners. Generate, store and use your own clean energy.
        </p>
      </div>

      <div>
        <h4>Products</h4>
        <a href="/products/">Solar PV</a>
        <a href="/products/#battery">Battery storage</a>
        <a href="/residential/">Residential systems</a>
      </div>

      <div>
        <h4>Company</h4>
        <a href="/about/">About</a>
        <a href="/news/">News</a>
        <a href="/contact/">Contact</a>
        <a href="/faq/">FAQ</a>
      </div>

      <div>
        <h4>Resources</h4>
        <a href="/resources/">Technical docs</a>
        <a href="/faq/">Help centre</a>
        <a href="/contact/">Installer network</a>
      </div>
    </div>

    <div class="commitments" style="border-top:1px solid rgba(255,255,255,0.12); margin-top:36px; padding-top:20px; display:flex; flex-wrap:wrap; gap:8px 22px; justify-content:center; font-size:0.85rem; color:#8aa0bd">
      <span><strong style="color:#fff">25-year</strong> PV performance guarantee</span>
      <span aria-hidden="true" style="opacity:0.4">·</span>
      <span><strong style="color:#fff">10-year</strong> LiFePO₄ battery warranty</span>
      <span aria-hidden="true" style="opacity:0.4">·</span>
      <span><strong style="color:#fff">Certified</strong> installer network</span>
      <span aria-hidden="true" style="opacity:0.4">·</span>
      <span>Warranty &amp; claims: <a href="mailto:info@sunhestia.com" style="color:#c4d2e4; display:inline; padding:0">info@sunhestia.com</a></span>
    </div>

    <div class="legal">
      <span>© {year} SunHestia. All rights reserved.</span>
      <span>
        <a href="/legal/privacy/">Privacy</a> ·
        <a href="/legal/terms/">Terms</a> ·
        <a href="/legal/imprint/">Imprint</a>
      </span>
    </div>
  </div>
</footer>
