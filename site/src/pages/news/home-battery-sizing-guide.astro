const toc: TocItem[] = [
  { id: "what-self-consumption-means-and-why-it-drives-sizing", text: "What self-consumption means — and why it drives sizing", depth: 2 },
  { id: "the-sizing-method-step-by-step", text: "The sizing method, step by step", depth: 2 },
  { id: "spec-card-sunhestia-home-battery", text: "Spec card: SunHestia Home Battery", depth: 2 },
  { id: "spec-card-sunhestia-solar-pv-modules", text: "Spec card: SunHestia Solar PV Modules", depth: 2 },
  { id: "comparison-table-choosing-a-capacity", text: "Comparison table: choosing a capacity", depth: 2 },
  { id: "installation-and-warranty-at-a-glance", text: "Installation and warranty at a glance", depth: 2 },
  { id: "faq", text: "FAQ", depth: 2 },
  { id: "faq-what-does-a-residential-solar-and-storage-system-include", text: "What does a residential solar and storage system include?", depth: 3 },
  { id: "faq-how-big-should-my-battery-be", text: "How big should my battery be?", depth: 3 },
  { id: "faq-do-i-need-a-battery-with-solar-panels", text: "Do I need a battery with solar panels?", depth: 3 },
  { id: "faq-what-roof-types-are-suitable", text: "What roof types are suitable?", depth: 3 },
