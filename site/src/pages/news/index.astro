---
import Layout from "../../layouts/Layout.astro";

const posts = [
  {
    slug: "home-battery-sizing-guide",
    date: "2026-09",
    title: "How to Size a Home Solar Battery: A Practical Guide",
    excerpt: "Match storage to evening electricity use: the common 5–10 kWh starting range for a detached home, modular scaling to 15 kWh, roof and tariff checks, and full spec cards.",
  },
  {
    slug: "about-the-team",
    date: "2026-09",
    title: "Who Designs and Installs Your SunHestia System",
    excerpt: "Consumption-first battery sizing, roof-by-roof assessment, the hardware our teams install, single-day installation and the guarantees behind the work.",
  },
  {
    slug: "home-solar-battery-deep-dive",
    date: "2026-09",
    title: "Home Solar & Battery Storage: A Data-Driven Deep Dive",
    excerpt: "Every concrete data point behind a residential solar and storage system — module wattage, battery capacity, warranty terms — with sizing guidance and self-consumption definitions.",
  },
  {
    slug: "glossary",
    date: "2026-09",
    title: "Solar & Battery Glossary: Core Terms",
    excerpt: "Self-consumption, LiFePO4, hybrid inverters — the core solar and battery terminology, with each definition tied to the hardware facts of a real residential system.",
  },
  {
    slug: "solar-only-vs-solar-plus-battery",
    date: "2026-09",
    title: "Solar Only vs Solar + Battery: A Side-by-Side Comparison",
    excerpt: "What exactly does a home battery add to rooftop solar? A side-by-side look at components, self-consumption, backup capability, hardware specs, sizing and warranty.",
  },
  {
    slug: "solar-only-vs-solar-plus-battery-storage",
    date: "2026-08",
    title: "Solar Panels Only vs Solar + Battery Storage",
    excerpt: "A side-by-side comparison of the two configurations: what changes when you add a home battery, from self-consumption and evening supply to backup and monitoring.",
  },
  {
    slug: "self-consumption-guide",
    date: "2026-08",
    title: "Solar Self-Consumption: The Homeowner's Guide",
    excerpt: "The deeper guide: how a hybrid inverter and a LiFePO4 home battery raise the share of your solar power you use yourself — sizing, specs and warranties included.",
  },
  {
    slug: "what-is-self-consumption",
    date: "2026-07",
    title: "What is self-consumption, and why does it matter?",
    excerpt: "Self-consumption is the share of your solar electricity that you use yourself. Here is why it matters more than the size of your panels.",
  },
  {
    slug: "lifepo4-home-batteries",
    date: "2026-07",
    title: "Why we use LiFePO4 for home batteries",
    excerpt: "Lithium iron phosphate cells trade a little energy density for long life, stability and a cobalt-free supply chain.",
  },
];
---
<Layout
  title="Solar & Battery Storage News"
  description="News and articles from SunHestia on residential solar, home battery storage and self-consumption."
  path="news"
>
  <section class="hero" style="padding: 64px 0">
    <div class="wrap">
      <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem)">News & stories</h1>
      <p class="lead">Notes on solar, storage and running a home on its own energy.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid cols-2">
        {posts.map((p) => (
          <a class="card" href={`/news/${p.slug}/`} style="display:block; color:inherit">
            <div style="font-size:.85rem; color:var(--c-ink-soft)">{p.date}</div>
            <h3 style="margin:8px 0">{p.title}</h3>
            <p>{p.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
